# Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://username:password@localhost/airq

# Security Configuration (REQUIRED)
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# CORS Configuration
# Comma-separated list of allowed origins
# Include localhost for development and mini.local for network access
CORS_ORIGINS=http://mini.local:3000
CORS_CREDENTIALS=false

# GraphQL Security Configuration
GRAPHQL_INTROSPECTION=false
GRAPHQL_GRAPHIQL=false
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=150
GRAPHQL_TIMEOUT=30
GRAPHQL_RATE_LIMIT_PER_MINUTE=100

# Production Configuration Notes:
# - Set FLASK_ENV=production for production deployments
# - Set FLASK_DEBUG=false for production
# - Set FLASK_HOST=0.0.0.0 to allow external connections (required for Raspberry Pi sensors)
# - Use a strong SECRET_KEY (32+ characters)
# - Configure DATABASE_URL with production credentials
# - Set appropriate CORS_ORIGINS for your frontend domains and sensor devices
# - Keep GraphQL security settings strict in production

# Network Access Notes:
# - FLASK_HOST=0.0.0.0 allows connections from any IP address on the network
# - CORS_ORIGINS includes mini.local for local network access (mDNS)
# - Ensure firewall allows incoming connections on the specified port if needed
# - Server will be accessible on:
#   - localhost:5000 (local development)
#   - mini.local:5000 (from any device on local network)
#   - Direct IP access (10.x.x.x:5000)

# Local Network Domain Setup:
# - Uses mDNS (multicast DNS) for mini.local resolution
# - Works automatically on most modern networks
# - Raspberry Pi sensors should connect to: mini.local:5000
# - Frontend apps can use: http://mini.local:5000/graphql
# - Only accessible within your local network (not from internet)

# Email Alerts Configuration (Optional)
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
MOCK_EMAIL=true
BASE_URL=http://localhost:3000

# Ring Integration (Optional)
# Get refresh token via: npx ring-auth-cli
RING_REFRESH_TOKEN=your-ring-refresh-token